# =============================================================================
#  Indian Spiritual Content Engine — environment template
#  Copy to `.env.local` for local dev, and paste the same values into
#  Vercel → Project → Settings → Environment Variables for production.
#  EVERY service below has a free tier. Total cost: ₹0.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE  →  https://supabase.com  (free project)
#    Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key. Safe to expose. RLS blocks it from reading the queue —
# it exists so client code can be added later without a rewrite.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SECRET. Server-side only, bypasses RLS.
# Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket created by supabase/schema.sql. Leave as-is unless renamed.
SUPABASE_AUDIO_BUCKET=spiritual-audio


# -----------------------------------------------------------------------------
# 2. GOOGLE GEMINI  →  https://aistudio.google.com/app/apikey  (free tier)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
# Thinking budget in tokens. 0 = fastest (fits Vercel's 60s Hobby limit
# comfortably); 512–1024 = slightly richer writing. Max 24576.
GEMINI_THINKING_BUDGET=512


# -----------------------------------------------------------------------------
# 3. YOUTUBE DATA API v3  →  https://console.cloud.google.com  (free quota)
#    a) Create a project → enable "YouTube Data API v3"
#    b) OAuth consent screen → External → add yourself as a Test user
#    c) Credentials → Create OAuth client ID → type "Desktop app"
#    d) Run `npm run auth:youtube` to mint the refresh token below.
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# 'public' | 'unlisted' | 'private'. Start with 'unlisted' while you test.
YOUTUBE_PRIVACY_STATUS=public
# 22 = People & Blogs, 24 = Entertainment, 27 = Education
YOUTUBE_CATEGORY_ID=22
# Made-for-kids declaration required by YouTube. Keep false.
YOUTUBE_MADE_FOR_KIDS=false


# -----------------------------------------------------------------------------
# 4. GITHUB ACTIONS RENDERER  (free minutes — this is what runs FFmpeg)
#    Vercel cannot render video, so pressing Approve dispatches a GitHub
#    Actions run that builds the 1080x1920 MP4 and uploads it to YouTube.
#    Token: github.com → Settings → Developer settings →
#           Personal access tokens → Fine-grained → your repo →
#           Repository permissions → Contents: Read and write
# -----------------------------------------------------------------------------
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DISPATCH_TOKEN=

# Shared secret the Action uses to report success/failure back to Vercel.
# Generate one: openssl rand -hex 32   (or any long random string)
PUBLISH_CALLBACK_SECRET=

# Your deployed site, e.g. https://spiritual-engine.vercel.app
# Used by the Action to call back, and by the cron job. No trailing slash.
NEXT_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
# 5. ENGINE TUNING  (all optional — sensible defaults are compiled in)
# -----------------------------------------------------------------------------
# Indian female neural voice. Alternatives: en-IN-PrabhatNeural (male),
# hi-IN-SwaraNeural (Hindi female), hi-IN-MadhurNeural (Hindi male).
TTS_VOICE=en-IN-NeerjaNeural
# Prosody. Slightly slower than default reads better for devotional content.
TTS_RATE=-4%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%

# Target spoken length. The engine enforces this by word count.
TARGET_SECONDS=30
# Reject a script if pg_trgm similarity to any recent script exceeds this.
# 0.45 is strict; raise toward 0.6 only if generation starts failing.
SIMILARITY_THRESHOLD=0.45
# How many fresh topics to try before giving up on a run.
MAX_GENERATION_ATTEMPTS=4

# Protects /api/cron/generate. Vercel Cron sends this automatically once set
# in project settings; also accepted as ?secret= for manual triggering.
CRON_SECRET=

# OPTIONAL: leave blank for an open dashboard (as configured). Set any value
# to switch on a password gate over the dashboard and all write routes.
DASHBOARD_PASSWORD=


# -----------------------------------------------------------------------------
# 6. DAILY MAHA PURANA ROTATION
#    The engine walks the eighteen Maha Puranas in their traditional order,
#    one per day. Purely a function of the date — no cursor is stored, so it
#    cannot drift, and the same date always yields the same Purana.
# -----------------------------------------------------------------------------
# 'off' falls back to weighted-random selection across the whole ledger.
PURANA_ROTATION=on
# Day zero of the cycle. Any parseable date. Shift this to re-phase the cycle.
ROTATION_EPOCH=1970-01-01
# Bump to 2 to spend two days on each Purana, etc.
ROTATION_DAYS_PER_PURANA=1


# -----------------------------------------------------------------------------
# 7. LOCAL PYTHON RENDERER  (render/render_short.py — optional)
#    Only needed if you render on your own machine instead of GitHub Actions.
# -----------------------------------------------------------------------------
# Free key from https://www.pexels.com/api/ for mythological backgrounds.
# Leave blank and the renderer generates its own gradient instead.
PEXELS_API_KEY=

# Absolute path to a bold .ttf. Blank = auto-discovered per platform.
FONT_PATH=

# Every visual value is overridable; these are the defaults.
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=21
KEN_BURNS_ZOOM=1.18
CAPTION_FONT_SIZE=74
CAPTION_STROKE=8
CAPTION_BOTTOM=420
CAPTION_WORDS_PER_CUE=4
BACKGROUND_BLUR=3.0
BACKGROUND_DIM=0.55
