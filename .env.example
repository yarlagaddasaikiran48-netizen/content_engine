# ============================================================================
#  Environment
#
#  The goal is two values here and everything else pasted into Settings in the
#  app. That is where the project is heading; read the note further down for
#  what is still read from this file today.
# ============================================================================

# ---------------------------------------------------------------------------
#  REQUIRED — the one thing a database cannot store about itself.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The anon key is only used by the browser client, which nothing imports yet.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
#  OPTIONAL OVERRIDES — leave both unset unless you need them.
# ---------------------------------------------------------------------------

# Settings are encrypted with a key derived from SUPABASE_SERVICE_ROLE_KEY.
# Set this ONLY if you rotate that key and need previously saved secrets to
# keep decrypting; set it to the PREVIOUS service-role key.
# SETTINGS_MASTER_KEY=

# Turns the password gate in middleware.ts back on. Unset means no login at
# all, which is the current deliberate choice. Edge middleware cannot decrypt,
# so this one value can only live here, never in Settings.
# DASHBOARD_PASSWORD=

# ============================================================================
#  MIGRATION IN PROGRESS — read this before deleting anything below.
#
#  Every value below is now editable at /settings, stored encrypted, and takes
#  precedence over whatever is set here. But only the YouTube connection reads
#  from Settings so far. The generation pipeline still reads these variables
#  directly and will throw if they are missing, so until that migration lands
#  you need BOTH: paste them in Settings *and* keep them here.
#
#  Once the pipeline reads Settings, everything below can be deleted.
# ============================================================================

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.6-flash

# --- YouTube ---
# Create an OAuth client (type: Web application) in Google Cloud Console and
# add <your site>/api/youtube/callback as an authorised redirect URI. Then use
# the Connect YouTube button in Settings — there is no longer a CLI step.
YOUTUBE_CLIENT_ID=your-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-oauth-client-secret
# YOUTUBE_REFRESH_TOKEN is written to Settings by the Connect button.
# YOUTUBE_PRIVACY_STATUS=public

# --- GitHub Actions renderer ---
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_DISPATCH_TOKEN=your-fine-grained-token

# --- Tuning (all have working defaults) ---
# TARGET_SECONDS=30
# TTS_VOICE=en-IN-NeerjaNeural
# TTS_RATE=-4%
# TTS_WORDS_PER_MINUTE=148
# WORD_COUNT_TOLERANCE=0.15
# SIMILARITY_THRESHOLD=0.45

# --- Deployment ---
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# CRON_SECRET=a-long-random-string
# PUBLISH_CALLBACK_SECRET=another-long-random-string

# ---------------------------------------------------------------------------
#  Renderer (read by render/render_short.py on the GitHub Actions runner,
#  not by the Next.js app). All optional — every one has a working default.
# ---------------------------------------------------------------------------

# Free key from https://www.pexels.com/api/ — without it every video falls back
# to the same generated gradient, so all your Shorts look identical.
PEXELS_API_KEY=

# VIDEO_WIDTH=1080
# VIDEO_HEIGHT=1920
# VIDEO_FPS=30
# VIDEO_CRF=21
# KEN_BURNS_ZOOM=1.18
# BACKGROUND_BLUR=3.0
# BACKGROUND_DIM=0.55
# CAPTION_FONT_SIZE=74
# CAPTION_STROKE=8
# CAPTION_BOTTOM=420
# CAPTION_WORDS_PER_CUE=4
# FONT_PATH=

# ---------------------------------------------------------------------------
#  Remaining tuning knobs. Also settable in the app; these are the fallbacks.
# ---------------------------------------------------------------------------
# SUPABASE_AUDIO_BUCKET=spiritual-audio
# GEMINI_THINKING_BUDGET=512
# MAX_GENERATION_ATTEMPTS=4
# TTS_PITCH=+0Hz
# TTS_VOLUME=+0%
# YOUTUBE_CATEGORY_ID=22
# YOUTUBE_MADE_FOR_KIDS=false
# PURANA_ROTATION=on
# ROTATION_EPOCH=
# ROTATION_DAYS_PER_PURANA=1
