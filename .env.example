# Copy to .env and load it yourself, or set these directly in your shell.
# Windows PowerShell:  $env:GROQ_API_KEY = "gsk_..."
# bash/zsh:            export GROQ_API_KEY="gsk_..."

# ---- Required (generation) ----
YOUTUBE_API_KEY=
GROQ_API_KEY=

# ---- Optional tuning ----
GROQ_MODEL=llama-3.3-70b-versatile
REGION_CODE=US
FONT_PATH=
OUTPUT_DIR=output

# ---- Instagram Reels (leave blank to skip) ----
IG_USER_ID=
IG_ACCESS_TOKEN=
PUBLIC_VIDEO_URL=
AUTO_UPLOAD_HOST=

# ---- YouTube Shorts (leave blank to skip) ----
YT_CLIENT_SECRETS=
YT_TOKEN_FILE=token.json
YT_PRIVACY=public

# ---- Flags ----
DRY_RUN=1
