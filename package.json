  "description": "Automated Indian spiritual content engine for YouTube Shorts. Zero-cost stack: Next.js on Vercel + Supabase + Gemini + Edge TTS + GitHub Actions.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
