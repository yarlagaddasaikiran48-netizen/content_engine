    "test:watch": "vitest",
    "seed:topics": "tsx scripts/seed-topics.ts",
    "tts:test": "tsx scripts/test-tts.ts",
    "render": "tsx scripts/render-and-publish.ts",
    "selftest": "tsx scripts/self-test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
